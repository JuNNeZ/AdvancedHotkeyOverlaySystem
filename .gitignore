# Editor settings are local, but .vscode/scripts holds the verification
# scripts the release workflow runs, so that directory must stay tracked.
/.vscode/*
!/.vscode/scripts/

AdvancedHotkeyOverlaySystem.code-workspace
/build/

# Python bytecode from Tools/
__pycache__/

# Local AI agent definitions (wow-addon-architect) - not part of the addon
/.claude/
/.codex/
/.github/agents/

# Raw and cropped screenshots for the CurseForge page
/screenshots/
